---
import '../styles/main.scss';
import '../styles/fonts.css';
import interFont from '../assets/fonts/inter.woff2';

interface Props {
  title: string;
  description: string;
  bodyId?: string;
  bodyClass?: string;
  noFoucTransition?: boolean;
  viewport?: string;
  ogType?: 'website' | 'article' | 'profile';
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  bodyId,
  bodyClass,
  noFoucTransition = false,
  viewport = 'width=device-width, initial-scale=1.0',
  ogType = 'website',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const SITE = 'https://joeymanani.com';
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');
const canonical = new URL(cleanPath || '/', SITE).href;
const ogImage = new URL(image, SITE).href;
const fullTitle = title === 'Joey Manani' ? title : `${title} — Joey Manani`;
---

<!doctype html>
<html lang="en">
<head>
    <title>{fullTitle}</title>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="viewport" content={viewport}>
    <meta name="description" content={description}>
    <meta name="keywords" content="TheFlyingRat, Joey M, Software Developer, Web Development, Scripting languages, The, Flying, Rat, socials, youtube, snapchat, github">
    <meta name="author" content="Joey Manani">
    <meta name="theme-color" content="#121212">
    {noindex && <meta name="robots" content="noindex, follow">}
    <link rel="canonical" href={canonical}>

    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content="Joey Manani">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <style is:inline>
        body {
            background-color: #121212;
            opacity: 0.001;
            transition: opacity 600ms;
        }
    </style>
    <noscript><style>body{opacity:1!important;transition:none!important;overflow:auto!important}</style></noscript>
    {noFoucTransition && (
        <style is:inline>
            body { transition: none; overflow: hidden; }
        </style>
    )}
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin>
    <style is:inline set:html={`@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('${interFont}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
    <slot name="head" />
</head>
<body id={bodyId} class={bodyClass}>
    <slot />
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b3b04857a4f7456d84c29d92268a8438"}'></script>
</body>
</html>
